# AgentX后端开发环境Dockerfile
# 使用官方 Maven + JDK 17 基础镜像，避免容器内找不到 mvnw 的问题
FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/maven:3.9-eclipse-temurin-17 AS dev

# 设置工作目录
WORKDIR /app

# 配置Maven阿里云镜像加速
COPY docker/settings.xml /root/.m2/settings.xml

# 复制全部项目源码
COPY AgentX/pom.xml ./
COPY AgentX/.mvn ./.mvn
COPY AgentX/src ./src

# 一次性编译打包（依赖会自动下载，走阿里云镜像）
RUN mvn -B -Dmaven.test.skip=true package

# 清理构建产物避免冲突
RUN mvn clean

# 创建日志和存储目录
RUN mkdir -p logs storage

# 暴露后端端口
EXPOSE 8088

# 开发环境JVM参数（启用调试和热重载）
ENV JAVA_OPTS="-Xms256m -Xmx512m -Xdebug -Xrunjdwp:transport=dt_socket,server=y,suspend=n,address=*:5005 -Dspring.devtools.restart.enabled=true"

# 暴露调试端口
EXPOSE 5005

# 开发模式启动（支持热重载）
CMD ["mvn", "spring-boot:run", "-Dspring-boot.run.jvmArguments=${JAVA_OPTS}"]
