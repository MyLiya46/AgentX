# ============================================
# 阿里云 OSS 对象存储配置
# ============================================
# 请从阿里云 RAM 访问控制获取 AccessKey
# 生产环境建议使用 RAM 子账号 + 最小权限策略
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_ACCESS_KEY=your_access_key_id
OSS_SECRET_KEY=your_access_key_secret
OSS_BUCKET_NAME=example-of-oss
OSS_REGION=cn-guangzhou
OSS_DOMAIN=https://example-of-oss.oss-cn-guangzhou.aliyuncs.com/
